    <title>Force OL Idle</title>
    <EMBEDDEDDATA mmedaddress="0xFE9F" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <mask>0x01</mask>
    <description>Custom bit0: force open loop when normalized TPS &lt;= 0xFF8B. This is a TPS gate, not the RPM idle-capture flag. The global bit1 takes precedence.</description>
    <CATEGORYMEM index="0" category="1" />
  </XDFFLAG>
  <XDFFLAG uniqueid="0x7E35">
    <title>Disable CL Fuelling Globally</title>
